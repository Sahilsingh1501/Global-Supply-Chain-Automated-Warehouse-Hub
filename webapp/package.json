{
  "name": "supply-chain-warehouse-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "dev:services": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-api.ps1",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build && npm run build:api",
    "build:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-api.ps1",
    "typecheck": "tsc --noEmit",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-api.ps1"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
